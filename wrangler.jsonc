{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "nasikandartycoon",
 "main": "cloudflare/worker.mjs",
 "compatibility_date": "2026-10-24",
 "assets": {
  "directory": "./public",
  "binding": "ASSETS",
  "run_worker_first": ["/api/*", "/", "/index.html"]
 },
 "d1_databases": [{"binding":"DB","database_name":"nasikandartycoon-db","migrations_dir":"./drizzle"}]
}
